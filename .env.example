APP_NAME=GEULIS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8020
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Basis data ─────────────────────────────────────────
# MariaDB berjalan di HOST (WSL); container menjangkaunya lewat host.docker.internal.
# Bukan localhost — dari dalam container, localhost adalah container itu sendiri.
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=db_geulis
DB_USERNAME=app
DB_PASSWORD=app123

# ── Sesi, cache, antrean ───────────────────────────────
# Sengaja memakai driver database, bukan Redis: menekan biaya hosting
# dan menghindari satu layanan lagi yang harus diurus tim kecil.
SESSION_DRIVER=database
SESSION_LIFETIME=240
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=log
MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# ═══════════════════════════════════════════════════════
# PARAMETER PENELITIAN
# ═══════════════════════════════════════════════════════
# Seluruh nilai di bawah ini IKUT DIVALIDASI AHLI dan wajib dilaporkan
# apa adanya di bagian metode artikel.
#
# JANGAN mengubahnya setelah validasi ahli dimulai — perubahan setelah
# titik itu membatalkan keabsahan hasil validasi terhadap produk yang diuji.

# Mesin Diferensiasi
GEULIS_ALPHA=0.4
GEULIS_AMBANG_L2=60
GEULIS_AMBANG_L3=80
GEULIS_AMBANG_PROMOSI=0.80
GEULIS_AMBANG_REMEDIAL=0.50
GEULIS_MAKS_REMEDIAL=2

# Motif Builder
GEULIS_MOTIF_RESOLUSI=200
GEULIS_MOTIF_AMBANG_LOLOS=90

# Etika data — jangan pernah diberi nilai lain
GEULIS_ANONIMKAN_EKSPOR=true
GEULIS_PARAMETER_TERKUNCI=false
